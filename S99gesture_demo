#!/bin/sh
### BEGIN INIT INFO
# Provides:          gesture_demo
# Required-Start:    $network $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Hand Gesture Recognition Demo
### END INIT INFO

DEMO_EXEC="/root/sq_handkp_class_linux.elf"
MODEL_DET="/root/hand_det.kmodel"
MODEL_KP="/root/handkp_det.kmodel"
LOG_FILE="/var/log/gesture_demo.log"
PID_FILE="/var/run/gesture_demo.pid"

case "$1" in
    start)
        echo "Starting Hand Gesture Recognition Demo..."
        if [ -f "$PID_FILE" ]; then
            echo "Already running (PID: $(cat $PID_FILE))"
            exit 0
        fi
        nohup $DEMO_EXEC $MODEL_DET None 0.5 0.5 $MODEL_KP 0 > $LOG_FILE 2>&1 &
        echo $! > $PID_FILE
        echo "Started (PID: $!)"
        ;;
    stop)
        echo "Stopping Hand Gesture Recognition Demo..."
        if [ -f "$PID_FILE" ]; then
            kill $(cat $PID_FILE) 2>/dev/null
            rm -f $PID_FILE
            echo "Stopped"
        else
            echo "Not running"
        fi
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    status)
        if [ -f "$PID_FILE" ]; then
            echo "Running (PID: $(cat $PID_FILE))"
        else
            echo "Not running"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0